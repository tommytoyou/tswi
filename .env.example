# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/tswi?retryWrites=true&w=majority
MONGODB_DB=tswi

# Cesium Ion Access Token (get from cesium.com/ion)
NEXT_PUBLIC_CESIUM_ION_TOKEN=your_cesium_ion_access_token

# API Configuration
API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Auth (Mock for MVP - replace with real auth later)
AUTH_SECRET=your-secret-key-change-in-production

# Edge Runtime Configuration
EDGE_CONFIG=

# TODO: Add external data source API keys when ready
# NOAA_SWPC_API_KEY=
# NASA_DONKI_API_KEY=
# SUPERMAG_API_KEY=

# Optional: Monitoring & Observability
# SENTRY_DSN=
# VERCEL_ANALYTICS_ID=
