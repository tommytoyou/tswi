# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/tswi?retryWrites=true&w=majority
MONGODB_DB=tswi

# Cesium Ion Access Token (get from cesium.com/ion)
NEXT_PUBLIC_CESIUM_ION_TOKEN=your_cesium_ion_access_token

# API Configuration
API_BASE_URL=http://localhost:5000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Auth (Mock for MVP - replace with real auth later)
AUTH_SECRET=your-secret-key-change-in-production

# Edge Runtime Configuration
EDGE_CONFIG=

# TODO: Add external data source API keys when ready
# NOAA_SWPC_API_KEY=
# NASA_DONKI_API_KEY=
# SUPERMAG_API_KEY=

# ============================================================================
# AGENTIC AI SYSTEM
# ============================================================================

# Anthropic Claude API (for AI reasoning and decision making)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Hugging Face API (for AI model inference)
HUGGINGFACE_API_TOKEN=your_huggingface_api_token_here

# Cron Job Security (for API authentication)
CRON_SECRET=your_secure_random_string_here

# Email Notifications (choose one)
# Option 1: Resend (recommended - simpler API)
RESEND_API_KEY=your_resend_api_key_here
# Option 2: SendGrid
# SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_FROM=alerts@tswi.space

# SMS Notifications (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# WebSocket/Push Notifications (optional - for production)
# PUSHER_APP_ID=
# PUSHER_KEY=
# PUSHER_SECRET=
# PUSHER_CLUSTER=

# Optional: Monitoring & Observability
# SENTRY_DSN=
# VERCEL_ANALYTICS_ID=

# ============================================================================
# SPACE DOMAIN AWARENESS (Space-Track.org)
# ============================================================================

# Space-Track.org credentials (free account at https://www.space-track.org)
SPACE_TRACK_USERNAME=
SPACE_TRACK_PASSWORD=
